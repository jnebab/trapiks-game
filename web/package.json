{
  "name": "trapiks-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "wasm": "bash ../scripts/build-wasm.sh",
    "dev": "pnpm wasm && vite",
    "build": "pnpm wasm && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run --passWithNoTests",
    "check:comments": "node ../scripts/check-no-comments.mjs"
  },
  "dependencies": {
    "@fontsource/lexend": "5.3.0",
    "pixi.js": "8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "eslint-plugin-sonarjs": "4.2.1",
    "jiti": "2.7.0",
    "prettier": "3.9.9",
    "typescript": "6.0.2",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
